@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    ViewData["Title"] = L("Publish", "انشر كتابك");
    ViewData["SeoTitle"] = L(
        "Publish Your Book with Qaro2a",
        "انشر كتابك مع قروءه");
    ViewData["MetaDescription"] = L(
        "Submit your manuscript to Qaro2a for publishing. Upload your PDF and our team will review your submission.",
        "قدّم مخطوطتك للنشر مع قروءه. ارفع ملف PDF وسيراجع فريقنا طلبك.");
    ViewData["MetaKeywords"] = L(
        "publish with Qaro2a, manuscript submission, Arabic publishing",
        "النشر مع قروءه, تقديم مخطوطة, نشر كتب, قروءه");
    var mobile = ViewBag.MobileNumber as string ?? string.Empty;
}

<section class="py-5">
    <div class="container" style="max-width: 720px;">
        <h2 class="mb-3">@L("Publish with Qaro2a", "انشر مع قروءه")</h2>
        <p class="text-muted mb-4">
            @L("Submit your manuscript as a PDF. Our team will review your submission and get back to you.", "أرسل مخطوطتك بصيغة PDF، وسيقوم فريقنا بمراجعتها والرد عليك.")
        </p>

        @if (TempData["PublishSuccess"] != null)
        {
            <div class="alert alert-success" role="alert">
                @L("Your submission was received successfully. We will contact you soon.", "تم استلام طلبك بنجاح. سنتواصل معك قريبًا.")
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Publish" asp-action="Index" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label for="mobileNumber" class="form-label">@L("Mobile number", "رقم الهاتف")</label>
                        <input type="tel" class="form-control" id="mobileNumber" name="mobileNumber"
                               value="@mobile" required maxlength="30" placeholder="+20 ..." />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">@L("Manuscript (PDF, max 5 MB)", "المخطوطة (PDF بحد أقصى 5 ميجابايت)")</label>
                        <div class="pub-drop" id="pubDrop" data-text="@System.Text.Json.JsonSerializer.Serialize(new { ready = L("File ready - press Submit", "الملف جاهز - اضغط إرسال"), notPdf = L("Only PDF files are accepted", "الملفات المقبولة PDF فقط"), tooBig = L("The file is larger than 5 MB", "حجم الملف أكبر من 5 ميجابايت") })">
                            <input type="file" class="pub-drop__input" id="pdfFile" name="pdfFile" accept=".pdf,application/pdf" required aria-label="@L("Manuscript PDF", "ملف المخطوطة PDF")" />
                            <div class="pub-drop__head">
                                <div>
                                    <p class="pub-drop__title">@L("Upload your manuscript", "ارفع مخطوطتك")</p>
                                    <p class="pub-drop__hint">@L("Click to choose a PDF, drag and drop it here, or take the shot.", "اضغط لاختيار ملف PDF، أو اسحبه هنا، أو سدّد الكرة.")</p>
                                </div>
                            </div>
                            <div class="pub-file" aria-live="polite">
                                <span class="pub-file__icon">PDF</span>
                                <div class="pub-file__body">
                                    <div class="pub-file__name"><span data-file-name></span><span data-file-size dir="ltr"></span></div>
                                    <div class="pub-file__bar"><i></i></div>
                                    <div class="pub-file__status"></div>
                                </div>
                                <button type="button" class="pub-file__remove" aria-label="@L("Remove file", "إزالة الملف")" title="@L("Remove file", "إزالة الملف")">&times;</button>
                            </div>
                            <svg class="pub-hoop" id="pubHoop" viewBox="0 0 130 150" aria-hidden="true">
                                <rect x="35" y="4" width="60" height="44" rx="5" fill="#fff" stroke="#3b3f8f" stroke-width="3" />
                                <rect x="52" y="22" width="26" height="18" rx="2" fill="none" stroke="#3b3f8f" stroke-width="2.5" />
                                <ellipse cx="65" cy="56" rx="32" ry="7" fill="none" stroke="#3b3f8f" stroke-width="4" />
                                <g class="net" stroke="#3b3f8f" stroke-width="1.6" fill="none" stroke-linecap="round">
                                    <path d="M34 58 L50 128 M45 62 L56 130 M58 63 L61 131 M72 63 L69 131 M85 62 L74 130 M96 58 L80 128" />
                                    <path d="M37 76 Q65 86 93 76 M41 94 Q65 103 89 94 M45 111 Q65 119 85 111" />
                                </g>
                            </svg>
                            <span class="pub-ball" id="pubBall" role="button" tabindex="0" aria-label="@L("Pick a file", "اختر ملفًا")">PDF</span>
                            <p class="pub-aim">@L("Aim the file and release to shoot into the basket.", "وجّه الملف وسيبه عشان يدخل السلة.")</p>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">@L("Submit", "إرسال")</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">@L("Cancel", "إلغاء")</a>
                </form>
            </div>
        </div>
    </div>
</section>

@section Head {
    <link rel="stylesheet" href="~/css/publish-drop.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/publish-drop.js" asp-append-version="true"></script>
}
