@model IEnumerable<ECommerce.Application.DTOs.Cart.CartItemDto>

@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    ViewData["Title"] = L("Cart", "السلة");
}

<link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />

<section class="cart-page-section">
    <div class="container cart-page-container">
        <h2 class="cart-page-title">@L("Your Cart", "سلة التسوق")</h2>

        @if (TempData["CartError"] is string cartError)
        {
            <div class="alert alert-warning" role="alert">@cartError</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="text-muted">
                @L("Your cart is empty.", "سلة التسوق فارغة.") <a asp-controller="Home" asp-action="Shop">@L("Continue shopping", "متابعة التسوق")</a>.
            </div>
        }
        else
        {
            var itemsSubtotal = Model.Sum(i => i.Subtotal);
            var deliveryFee = OrderPricing.DeliveryFee;
            var grandTotal = itemsSubtotal + deliveryFee;

            <div class="cart-items">
                @foreach (var item in Model)
                {
                    var atMaxStock = item.Quantity >= item.AvailableStock;
                    <article class="cart-card" data-item-id="@item.Id" data-max-stock="@item.AvailableStock">
                        <h3 class="cart-card__name">@item.ProductName</h3>
                        <div class="cart-card__row">
                            <span class="cart-card__price">@item.Price.ToString("N2") EGP</span>
                            <div class="cart-card__qty">
                                <button type="button" class="btn btn-sm btn-outline-secondary cart-qty-minus" aria-label="@L("Decrease quantity", "تقليل الكمية")">−</button>
                                <span class="cart-qty-value px-2">@item.Quantity</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary cart-qty-plus @(atMaxStock ? "disabled" : "")" aria-label="@L("Increase quantity", "زيادة الكمية")" @(atMaxStock ? "disabled" : null)>+</button>
                            </div>
                            <span class="cart-card__subtotal cart-subtotal">@item.Subtotal.ToString("N2") EGP</span>
                        </div>
                        <div class="cart-card__footer">
                            <span class="text-muted small">@L("Subtotal", "الإجمالي الفرعي")</span>
                            <button type="button" class="btn btn-sm btn-outline-danger cart-remove-item">@L("Remove", "حذف")</button>
                        </div>
                    </article>
                }
            </div>

            <div class="cart-summary">
                <p>
                    <span class="text-muted">@L("Items subtotal:", "إجمالي المنتجات:")</span>
                    <span class="fw-semibold ms-2">@itemsSubtotal.ToString("N2") EGP</span>
                </p>
                <p>
                    <span class="text-muted">@L("Delivery fee:", "رسوم التوصيل:")</span>
                    <span class="fw-semibold ms-2">@deliveryFee.ToString("N2") EGP</span>
                </p>
                <p class="fs-5">
                    <span class="text-muted">@L("Total:", "الإجمالي:")</span>
                    <span class="fw-bold ms-2">@grandTotal.ToString("N2") EGP</span>
                </p>
            </div>

            <div class="cart-actions">
                <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-primary">@L("Continue shopping", "متابعة التسوق")</a>
                <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary">@L("Checkout", "إتمام الطلب")</a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/cart.js"></script>
}
