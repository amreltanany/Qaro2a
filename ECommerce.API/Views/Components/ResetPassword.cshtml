@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    ViewData["Title"] = L("Reset Password", "إعادة تعيين كلمة المرور");
    var presetEmail = ViewBag.Email as string ?? string.Empty;
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <h2 class="text-center mb-3">@L("Reset Password", "إعادة تعيين كلمة المرور")</h2>
                <p class="text-center text-muted small mb-4">
                    @L("Enter the 6-digit code from your email and choose a new password.", "أدخل الرمز المكوّن من 6 أرقام من بريدك الإلكتروني واختر كلمة مرور جديدة.")
                </p>
                <div id="resetError" class="alert alert-danger d-none" role="alert"></div>
                <div id="resetSuccess" class="alert alert-success d-none" role="alert"></div>
                <form id="resetForm">
                    <div class="mb-3">
                        <label for="email" class="form-label">@L("Email", "البريد الإلكتروني")</label>
                        <input type="email" class="form-control" id="email" name="email" value="@presetEmail" autocomplete="username" required>
                    </div>
                    <div class="mb-3">
                        <label for="code" class="form-label">@L("Verification code", "رمز التحقق")</label>
                        <input type="text" class="form-control" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required>
                    </div>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">@L("New password", "كلمة المرور الجديدة")</label>
                        <input type="password" class="form-control" id="newPassword" name="newPassword" autocomplete="new-password" required minlength="6">
                    </div>
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">@L("Confirm password", "تأكيد كلمة المرور")</label>
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required minlength="6">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@L("Update password", "تحديث كلمة المرور")</button>
                </form>
                <p class="mt-3 text-center small">
                    <a asp-controller="Home" asp-action="ForgotPassword">@L("Resend code", "إعادة إرسال الرمز")</a>
                    ·
                    <a asp-controller="Home" asp-action="Login">@L("Back to login", "العودة لتسجيل الدخول")</a>
                </p>
            </div>
        </div>
    </div>
</section>

<script>
var i18n = {
    fallbackError: '@L("Something went wrong. Please try again.", "حدث خطأ ما. حاول مرة أخرى.")',
    passwordMismatch: '@L("Passwords do not match.", "كلمتا المرور غير متطابقتين.")',
    successMessage: '@L("Password updated successfully. Redirecting to login...", "تم تحديث كلمة المرور بنجاح. جاري التحويل لتسجيل الدخول...")'
};
function parseApiErrorResponse(res) {
    return res.text().then(function (text) {
        var fallback = i18n.fallbackError;
        var t = (text || '').trim();
        if (!t) return fallback;
        if (t.charAt(0) === '{' || t.charAt(0) === '[') {
            try {
                var d = JSON.parse(t);
                if (d && typeof d === 'object') {
                    if (d.message) return d.message;
                    if (d.title && d.title !== 'One or more validation errors occurred.') return d.title;
                }
            } catch (e) { /* ignore */ }
        }
        return t;
    });
}

document.getElementById('resetForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var errEl = document.getElementById('resetError');
    var okEl = document.getElementById('resetSuccess');
    errEl.classList.add('d-none');
    okEl.classList.add('d-none');

    var email = document.getElementById('email').value.trim();
    var code = document.getElementById('code').value.trim();
    var newPassword = document.getElementById('newPassword').value;
    var confirmPassword = document.getElementById('confirmPassword').value;

    if (newPassword !== confirmPassword) {
        errEl.textContent = i18n.passwordMismatch;
        errEl.classList.remove('d-none');
        return;
    }

    fetch('/api/Account/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ Email: email, Code: code, NewPassword: newPassword })
    })
    .then(function (res) {
        if (!res.ok) return parseApiErrorResponse(res).then(function (msg) { throw new Error(msg); });
        return res.json();
    })
    .then(function (data) {
        okEl.textContent = data.message || i18n.successMessage;
        okEl.classList.remove('d-none');
        setTimeout(function () {
            window.location.href = '/Home/Login';
        }, 1500);
    })
    .catch(function (err) {
        errEl.textContent = err.message || i18n.fallbackError;
        errEl.classList.remove('d-none');
    });
});
</script>
