@model IList<ECommerce.Application.DTOs.Product.ProductResponseDto>

@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    ViewData["Title"] = L("Shop", "المتجر");
    ViewData["SeoTitle"] = L(
        "Shop Arabic Books Online | Qaro2a Bookstore",
        "متجر كتب قروءه — تسوق كتب عربية أونلاين");
    ViewData["MetaDescription"] = L(
        "Browse and buy Arabic books at Qaro2a. Filter by author, category, and price. Discover new releases and top-rated titles.",
        "تسوق كتباً عربية في متجر قروءه. تصفّح حسب المؤلف والفئة والسعر واكتشف إصدارات جديدة وكتباً الأعلى تقييماً.");
    ViewData["MetaKeywords"] = L(
        "Qaro2a shop, Arabic books online, bookstore, buy books",
        "متجر قروءه, كتب عربية, شراء كتب, متجر كتب, قروءه");
    var searchTerm = ViewBag.Search as string;
    var isSearch = !string.IsNullOrWhiteSpace(searchTerm);
    var categories = ViewBag.Categories as IEnumerable<ECommerce.Application.DTOs.Category.CategoryResponseDto>
        ?? Enumerable.Empty<ECommerce.Application.DTOs.Category.CategoryResponseDto>();
    var sortBy = (ViewBag.SortBy as string) ?? string.Empty;
    var publishDateValue = ViewBag.PublishDate as string;
    var authorValue = (ViewBag.Author as string) ?? string.Empty;
    var minPriceValue = ViewBag.MinPrice;
    var maxPriceValue = ViewBag.MaxPrice;
    var selectedCategoryId = ViewBag.CategoryId as int?;
    var topRatedOnly = ViewBag.TopRated is bool tr && tr;
    ViewData["Branch"] = "shop";
    var categoryTitle = (!isSearch && string.IsNullOrWhiteSpace(authorValue) && selectedCategoryId.HasValue) ? categories.FirstOrDefault(c => c.Id == selectedCategoryId.Value)?.Name : null;
    var isCategoryPage = !string.IsNullOrWhiteSpace(categoryTitle);
    var isAuthorPage = !string.IsNullOrWhiteSpace(authorValue) && string.IsNullOrWhiteSpace(searchTerm);
    var hasActiveFilters = !string.IsNullOrWhiteSpace(publishDateValue)
        || !string.IsNullOrWhiteSpace(authorValue)
        || minPriceValue != null
        || maxPriceValue != null
        || selectedCategoryId.HasValue
        || topRatedOnly
        || !string.IsNullOrWhiteSpace(sortBy);
}

<link href="https://cdn.jsdelivr.net/npm/inter-ui@3.11.0/inter.min.css" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/css/button.css" asp-append-version="true" />
<link rel="stylesheet" type="text/css" href="~/css/shop-page.css" asp-append-version="true" />

<section id="billboard">
    <div class="container">
        <div class="row justify-content-center shop-search-header">
            <h1 class="section-title text-center mt-4" data-aos="fade-up">@(isSearch ? L("Search results", "نتائج البحث") : (isAuthorPage ? authorValue : (isCategoryPage ? categoryTitle : L("Shop", "المتجر"))))</h1>
            <div class="col-md-6 text-center" data-aos="fade-up" data-aos-delay="300">
                @if (isSearch)
                {
                    <p class="mb-2">@L("Results for", "نتائج البحث عن") &quot;@searchTerm&quot;</p>
                    <div class="shop-back-wrapper">
                        <a href="/Home/Shop" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i>@L("Back to Shop", "العودة إلى المتجر")
                        </a>
                    </div>
                }
                else if (isAuthorPage || isCategoryPage)
                {
                    <p class="shop-author-sub">@(isAuthorPage ? L("Books by the author", "كتب المؤلف") : L("Category", "القسم")) <span>·</span> @Model.Count @L("book(s)", "كتاب")</p>
                    <div class="shop-back-wrapper">
                        <a href="/Home/Shop" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-@(isArabic ? "right" : "left") me-1"></i>@L("All books", "كل الكتب")
                        </a>
                    </div>
                }
                else
                {
                    <p>@L("Books are mirrors read widely to see which reflection excites you most. Curiosity is the compass that leads to passion.", "الكتب مرايا؛ كلما قرأت أكثر اكتشفت الانعكاس الذي يشبهك. الفضول هو البوصلة التي تقود إلى الشغف.")</p>
                }
            </div>
        </div>

    </div>

    <div class="container-fluid px-3 px-lg-4">
        <div class="row g-4 py-3 align-items-start">
            <aside class="col-12 col-lg-3 col-xl-2">
                <div class="card shop-filter-sidebar sticky-top" style="top: 100px;">
                    <button class="shop-filter-toggle w-100 d-flex align-items-center justify-content-between border-0 bg-transparent p-0 mb-0"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#shopFilterCollapse"
                            aria-expanded="false"
                            aria-controls="shopFilterCollapse">
                        <h5 class="mb-0">@L("Filters", "الفلاتر")</h5>
                        <span class="shop-filter-toggle__icon" aria-hidden="true"><i class="bi bi-sliders"></i></span>
                        <i class="bi bi-chevron-down shop-filter-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="collapse shop-filter-collapse" id="shopFilterCollapse">
                    <div class="shop-filter-collapse-inner">
                    <form method="get" action="/Home/Shop" class="d-grid gap-3 shop-filter-form">
                        <input type="hidden" name="s" value="@searchTerm" />

                        <div>
                            <label class="form-label">@L("Publish Date", "تاريخ النشر")</label>
                            <input type="date" class="form-control" name="publishDate" value="@publishDateValue" />
                        </div>

                        <div>
                            <label class="form-label">@L("Author", "المؤلف")</label>
                            <input type="text" class="form-control" name="author" value="@authorValue" placeholder="@L("Author name...", "اسم المؤلف...")" />
                        </div>

                        <div>
                            <label class="form-label">@L("Price Range", "نطاق السعر")</label>
                            @{
                                int priceCeil = ViewBag.PriceCeil is int pc && pc > 0 ? pc : 1000;
                                int priceLo = minPriceValue != null ? (int)Math.Max(0, Math.Min((decimal)minPriceValue, priceCeil)) : 0;
                                int priceHi = maxPriceValue != null ? (int)Math.Max(0, Math.Min((decimal)maxPriceValue, priceCeil)) : priceCeil;
                            }
                            <div class="price-range" data-min="0" data-max="@priceCeil" dir="ltr">
                                <div class="price-range__values">
                                    <span><b id="priceLoLabel">@priceLo</b> EGP</span>
                                    <span><b id="priceHiLabel">@priceHi</b> EGP</span>
                                </div>
                                <div class="price-range__track">
                                    <div class="price-range__fill" id="priceFill"></div>
                                    <input type="range" id="priceLo" min="0" max="@priceCeil" step="5" value="@priceLo" aria-label="@L("Minimum price", "الحد الأدنى")" />
                                    <input type="range" id="priceHi" min="0" max="@priceCeil" step="5" value="@priceHi" aria-label="@L("Maximum price", "الحد الأقصى")" />
                                </div>
                                <input type="hidden" name="minPrice" id="priceMinField" value="@(minPriceValue != null ? priceLo.ToString() : "")" />
                                <input type="hidden" name="maxPrice" id="priceMaxField" value="@(maxPriceValue != null ? priceHi.ToString() : "")" />
                            </div>
                        </div>

                        <div>
                            <label class="form-label">@L("Category", "الفئة")</label>
                            <select class="form-select" name="categoryId">
                                <option value="">@L("All categories", "كل الفئات")</option>
                                @foreach (var category in categories)
                                {
                                    if (selectedCategoryId.HasValue && selectedCategoryId.Value == category.Id)
                                    {
                                        <option value="@category.Id" selected>@ECommerce.API.Helpers.CategoryLabels.Localize(category.Name, isArabic)</option>
                                    }
                                    else
                                    {
                                        <option value="@category.Id">@ECommerce.API.Helpers.CategoryLabels.Localize(category.Name, isArabic)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-check form-switch shop-toprated-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="topRated" name="topRated" value="true" @(topRatedOnly ? "checked" : null) />
                            <label class="form-check-label" for="topRated">@L("Top rated only", "الأعلى تقييمًا فقط")</label>
                        </div>

                        <div>
                            <label class="form-label">@L("Sort", "الترتيب")</label>
                            <select class="form-select" name="sortBy">
                                <option value="" selected="@(string.IsNullOrWhiteSpace(sortBy))">@L("Newest", "الأحدث")</option>
                                <option value="publishdate_desc" selected="@(sortBy == "publishdate_desc")">@L("Publish date: newest first", "تاريخ النشر: الأحدث أولاً")</option>
                                <option value="publishdate_asc" selected="@(sortBy == "publishdate_asc")">@L("Publish date: oldest first", "تاريخ النشر: الأقدم أولاً")</option>
                                <option value="author_asc" selected="@(sortBy == "author_asc")">@L("Author: A-Z", "المؤلف: أ-ي")</option>
                                <option value="author_desc" selected="@(sortBy == "author_desc")">@L("Author: Z-A", "المؤلف: ي-أ")</option>
                                <option value="price_asc" selected="@(sortBy == "price_asc")">@L("Price: low to high", "السعر: من الأقل إلى الأعلى")</option>
                                <option value="price_desc" selected="@(sortBy == "price_desc")">@L("Price: high to low", "السعر: من الأعلى إلى الأقل")</option>
                                <option value="category_asc" selected="@(sortBy == "category_asc")">@L("Category: A-Z", "الفئة: أ-ي")</option>
                                <option value="category_desc" selected="@(sortBy == "category_desc")">@L("Category: Z-A", "الفئة: ي-أ")</option>
                            </select>
                        </div>

                        <div class="shop-filter-actions">
                            <button type="submit" class="btn btn-primary">@L("Apply", "تطبيق")</button>
                            <a href="/Home/Shop" class="btn btn-outline-secondary">@L("Reset", "إعادة تعيين")</a>
                        </div>
                    </form>
                    </div>
                    </div>
                </div>
            </aside>

            <div class="col-12 col-lg-9 col-xl-10">
                @if (!Model.Any())
                {
                    <div class="row justify-content-center py-5">
                        <div class="col-md-6 text-center text-muted">
                            @if (isSearch)
                            {
                                <p class="mb-2">@L("No products found for", "لا توجد منتجات مطابقة لـ") &quot;@searchTerm&quot;.</p>
                            }
                            else
                            {
                                <p class="mb-0">@L("No products available at the moment.", "لا توجد منتجات متاحة حالياً.")</p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-4 py-1 shop-products-row" data-aos="fade-up" data-aos-delay="600">
                        @foreach (var product in Model)
                        {
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                @{
                                    var cardImg = Url.Content(product.ImageUrl ?? "~/logo/429827302_747764070661978_6323408778619379006_n-removebg-preview.png");
                                    string? cardBadge = string.IsNullOrWhiteSpace(product.CategoryName) ? null : ECommerce.API.Helpers.CategoryLabels.Localize(product.CategoryName, isArabic);
                                }
                                <div class="banner-item image-zoom-effect product-card h-100">
                                    <div class="image-holder shop-card-media">
                                        @if (cardBadge != null)
                                        {
                                            <span class="shop-card-badge">@cardBadge</span>
                                        }
                                        <button type="button" class="shop-wishlist-btn btn-add-wishlist" title="@L("Add to wishlist", "إضافة للمفضلة")" aria-label="@L("Add to wishlist", "إضافة للمفضلة")"
                                                data-product-id="@product.Id" data-product-name="@product.Name">
                                            <i class="bi bi-heart"></i>
                                        </button>
                                        <a href="@ECommerce.API.Helpers.SlugHelper.ProductPath(product.Id, product.Name)" class="shop-card-cover-link" aria-label="@product.Name"><img src="@cardImg" alt="@product.Name" class="img-fluid" loading="lazy" decoding="async" /></a>
                                        @if (!string.IsNullOrWhiteSpace(product.Description))
                                        {
                                            <div class="shop-card-peek" dir="rtl" aria-hidden="true">
                                                <p>@product.Description</p>
                                            </div>
                                        }
                                    </div>
                                    <div class="banner-content shop-card-body">
                                        <div class="shop-card-text" dir="rtl">
                                            <h5 class="element-title">
                                                <a class="item-anchor shop-card-title-link" href="@ECommerce.API.Helpers.SlugHelper.ProductPath(product.Id, product.Name)">@product.Name</a>
                                            </h5>
                                            <p class="shop-card-description">@product.Description</p>
                                            <div class="shop-card-meta">
                                                <a href="/Home/Author/@Uri.EscapeDataString(product.Author.Trim().Replace(" ", "-"))" class="shop-card-author-chip">@product.Author</a>
                                            </div>
                                        </div>
                                        <div class="shop-card-actions @(product.Stock > 0 ? null : "shop-card-actions--out-of-stock")">
                                            <p class="shop-card-price mb-0" dir="ltr">@product.Price.ToString("N0") <span class="shop-card-currency">EGP</span></p>
                                            @if (product.Stock > 0)
                                            {
                                                <div class="shop-qty" data-max="@product.Stock" role="group" aria-label="@L("Quantity", "الكمية")">
                                                    <button type="button" class="shop-qty__btn" data-qty-step="-1" aria-label="@L("Decrease quantity", "تقليل الكمية")" disabled>&minus;</button>
                                                    <output class="shop-qty__val" aria-live="polite">1</output>
                                                    <button type="button" class="shop-qty__btn" data-qty-step="1" aria-label="@L("Increase quantity", "زيادة الكمية")"@(product.Stock > 1 ? "" : " disabled")>+</button>
                                                </div>
                                                <button type="button" class="button btn-add-cart shop-cart-animate" data-product-id="@product.Id" data-product-name="@product.Name" aria-label="@L("Add to cart", "أضف إلى السلة")">
                                                    <i class="bi bi-cart3 shop-cart-idle" aria-hidden="true"></i>
                                                    <span class="shop-cart-label">
                                                        <i class="bi bi-plus-lg shop-cart-plus-icon" aria-hidden="true"></i>
                                                        @L("Add to cart", "أضف إلى السلة")
                                                    </span>
                                                    <div class="cart">
                                                        <svg viewBox="0 0 36 26">
                                                            <polyline points="1 2.5 6 2.5 10 18.5 25.5 18.5 28.5 7.5 7.5 7.5"></polyline>
                                                            <polyline points="15 13.5 17 15.5 22 10.5"></polyline>
                                                        </svg>
                                                    </div>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="shop-out-of-stock-btn" disabled>
                                                    <span>@L("Out of stock", "غير متوفر")</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        var lo = document.getElementById('priceLo'), hi = document.getElementById('priceHi');
        if (!lo || !hi) return;
        var fill = document.getElementById('priceFill'), loL = document.getElementById('priceLoLabel'), hiL = document.getElementById('priceHiLabel');
        var fMin = document.getElementById('priceMinField'), fMax = document.getElementById('priceMaxField');
        var min = +lo.min, max = +lo.max, gap = 5;
        function sync(source) {
            var a = +lo.value, b = +hi.value;
            if (a > b - gap) { if (source === lo) { a = b - gap; lo.value = a; } else { b = a + gap; hi.value = b; } }
            loL.textContent = a; hiL.textContent = b;
            var pa = (a - min) / (max - min) * 100, pb = (b - min) / (max - min) * 100;
            fill.style.left = pa + '%'; fill.style.right = (100 - pb) + '%';
            // untouched ends are not sent, so the filter only counts when it narrows the range
            fMin.value = a > min ? a : '';
            fMax.value = b < max ? b : '';
            lo.style.zIndex = a > max - 20 ? 5 : 3;
        }
        lo.addEventListener('input', function () { sync(lo); });
        hi.addEventListener('input', function () { sync(hi); });
        sync();
    })();
</script>
<script src="~/js/addToCart.js" asp-append-version="true"></script>
<script src="~/js/addToWishlist.js" asp-append-version="true"></script>