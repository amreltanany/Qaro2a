@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    ViewData["Title"] = L("Forgot Password", "نسيت كلمة المرور");
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <h2 class="text-center mb-3">@L("Forgot Password", "نسيت كلمة المرور")</h2>
                <p class="text-center text-muted small mb-4">
                    @L("Enter your email and we will send you a 6-digit code to reset your password.", "أدخل بريدك الإلكتروني وسنرسل لك رمزاً من 6 أرقام لإعادة تعيين كلمة المرور.")
                </p>
                <div id="forgotError" class="alert alert-danger d-none" role="alert"></div>
                <div id="forgotSuccess" class="alert alert-success d-none" role="alert"></div>
                <form id="forgotForm">
                    <div class="mb-3">
                        <label for="email" class="form-label">@L("Email", "البريد الإلكتروني")</label>
                        <input type="email" class="form-control" id="email" name="email" autocomplete="username" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@L("Send reset code", "إرسال رمز التحقق")</button>
                </form>
                <p class="mt-3 text-center small">
                    <a asp-controller="Home" asp-action="Login">@L("Back to login", "العودة لتسجيل الدخول")</a>
                </p>
            </div>
        </div>
    </div>
</section>

<script>
var i18n = {
    fallbackError: '@L("Something went wrong. Please try again.", "حدث خطأ ما. حاول مرة أخرى.")',
    sentMessage: '@L("If an account exists for that email, a reset code has been sent.", "إذا كان هناك حساب مرتبط بهذا البريد، فقد تم إرسال رمز التحقق.")'
};
function parseApiErrorResponse(res) {
    return res.text().then(function (text) {
        var fallback = i18n.fallbackError;
        var t = (text || '').trim();
        if (!t) return fallback;
        if (t.charAt(0) === '{' || t.charAt(0) === '[') {
            try {
                var d = JSON.parse(t);
                if (d && typeof d === 'object') {
                    if (d.message) return d.message;
                    if (d.title && d.title !== 'One or more validation errors occurred.') return d.title;
                }
            } catch (e) { /* ignore */ }
        }
        return t;
    });
}

document.getElementById('forgotForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var errEl = document.getElementById('forgotError');
    var okEl = document.getElementById('forgotSuccess');
    errEl.classList.add('d-none');
    okEl.classList.add('d-none');
    var email = document.getElementById('email').value.trim();

    fetch('/api/Account/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ Email: email })
    })
    .then(function (res) {
        if (!res.ok) return parseApiErrorResponse(res).then(function (msg) { throw new Error(msg); });
        return res.json();
    })
    .then(function (data) {
        okEl.textContent = data.message || i18n.sentMessage;
        okEl.classList.remove('d-none');
        setTimeout(function () {
            window.location.href = '/Home/ResetPassword?email=' + encodeURIComponent(email);
        }, 1500);
    })
    .catch(function (err) {
        errEl.textContent = err.message || i18n.fallbackError;
        errEl.classList.remove('d-none');
    });
});
</script>
