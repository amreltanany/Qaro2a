@model ECommerce.API.ViewModels.CheckoutViewModel

@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    ViewData["Title"] = L("Checkout", "إتمام الطلب");
}

<link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />

<section class="checkout-page-section">
    <div class="container checkout-page-container">
        <h2 class="checkout-page-title">@L("Checkout", "إتمام الطلب")</h2>

        <div class="checkout-layout">
            <div class="checkout-layout__summary">
                <h5 class="checkout-section-title">@L("Order Summary", "ملخص الطلب")</h5>
                <div class="checkout-items">
                    @foreach (var item in Model.CartItems)
                    {
                        <article class="checkout-card">
                            <div class="cart-card__head">
                                <span class="cart-card__cover cart-card__cover--sm">
                                    <img src="@Url.Content(item.ImageUrl ?? "~/logo/429827302_747764070661978_6323408778619379006_n-removebg-preview.png")" alt="@item.ProductName" loading="lazy" />
                                </span>
                                <h3 class="checkout-card__name">@item.ProductName</h3>
                            </div>
                            <div class="cart-card__row">
                                <span class="checkout-card__price">@item.Price.ToString("N2") EGP</span>
                                <span class="text-muted small">@L("Qty", "الكمية"): @item.Quantity</span>
                                <span class="checkout-card__subtotal">@item.Subtotal.ToString("N2") EGP</span>
                            </div>
                        </article>
                    }
                </div>
                <div class="checkout-summary">
                    <p>
                        <span class="text-muted">@L("Items subtotal:", "إجمالي المنتجات:")</span>
                        <span class="fw-semibold ms-2">@Model.ItemsSubtotal.ToString("N2") EGP</span>
                    </p>
                    <p>
                        <span class="text-muted">@L("Delivery fee:", "رسوم التوصيل:")</span>
                        <span class="fw-semibold ms-2" id="deliveryFeeValue">@(Model.HasGovernorate ? Model.DeliveryFee.ToString("N2") + " EGP" : L("Choose your governorate", "اختر المحافظة"))</span>
                    </p>
                    <p class="fs-5 fw-bold">
                        <span class="text-muted">@L("Total:", "الإجمالي:")</span>
                        <span class="ms-2" id="grandTotalValue" data-subtotal="@Model.ItemsSubtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.GrandTotal.ToString("N2") EGP</span>
                    </p>
                </div>
            </div>

            <div class="checkout-layout__shipping checkout-shipping">
                <h5 class="checkout-section-title">@L("Shipping details", "بيانات الشحن")</h5>
                @if (Model.IsGuest)
                {
                    <div class="checkout-guest-note">
                        <i class="bi bi-person-check" aria-hidden="true"></i>
                        <div>
                            <strong>@L("No account needed", "مش لازم حساب")</strong>
                            <span>@L("Enter your details below to place the order.", "اكتب بياناتك هنا وأكمل الطلب.")</span>
                            <span class="checkout-guest-note__links">
                                @L("Have an account?", "عندك حساب؟")
                                <a asp-controller="Home" asp-action="Login">@L("Log in", "سجّل دخول")</a>
                                <span>·</span>
                                <a asp-controller="Home" asp-action="Register">@L("Create one", "أنشئ حساب")</a>
                            </span>
                        </div>
                    </div>
                }
                <form asp-controller="Cart" asp-action="ConfirmCheckout" method="post" asp-antiforgery="true" id="checkoutForm">
                    <div class="mb-3">
                        <label for="FullName" class="form-label">@L("Full Name", "الاسم الكامل")</label>
                        <input type="text" class="form-control" id="FullName" name="FullName" value="@Model.FullName" autocomplete="name" @(Model.IsGuest ? "required" : "readonly") />
                    </div>
                    @if (!Model.IsGuest)
                    {
                        <div class="mb-3">
                            <label for="Email" class="form-label">@L("Email", "البريد الإلكتروني")</label>
                            <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" readonly />
                        </div>
                    }
                    <div class="mb-3">
                        <label for="Phone" class="form-label">@L("Phone number", "رقم الهاتف")</label>
                        <input type="tel" class="form-control" id="Phone" name="Phone" value="@Model.Phone" placeholder="@L("Enter your phone number", "أدخل رقم هاتفك")" required />
                    </div>
                    <div class="mb-3">
                        <label for="Governorate" class="form-label">@L("Governorate", "المحافظة")</label>
                        <select class="form-select" id="Governorate" name="Governorate" required>
                            <option value="" data-fee="">@L("Choose your governorate", "اختر المحافظة")</option>
                            @foreach (var g in ECommerce.Domain.Common.OrderPricing.Governorates)
                            {
                                <option value="@g.Key" data-fee="@ECommerce.Domain.Common.OrderPricing.FeeFor(g).ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(Model.Governorate == g.Key)">@L(g.En, g.Ar) - @ECommerce.Domain.Common.OrderPricing.FeeFor(g).ToString("N0") EGP</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="Address" class="form-label">@L("Address", "العنوان")</label>
                        <textarea class="form-control" id="Address" name="Address" rows="3" placeholder="@L("Enter your shipping address", "أدخل عنوان الشحن")" required>@Model.Address</textarea>
                    </div>
                    <button type="submit" class="checkout-place" id="placeOrderBtn">
                        <span class="checkout-place__label">@L("Place order", "تأكيد الطلب")</span>
                        <svg class="checkout-place__tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('checkoutForm');
            var btn = document.getElementById('placeOrderBtn');
            if (!form || !btn) return;
            var gov = document.getElementById('Governorate'), feeEl = document.getElementById('deliveryFeeValue'), totEl = document.getElementById('grandTotalValue');
            function fmt(n) { return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' EGP'; }
            function updateFee() {
                var o = gov.options[gov.selectedIndex], fee = parseFloat(o && o.getAttribute('data-fee'));
                if (isNaN(fee)) { feeEl.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("Choose your governorate", "اختر المحافظة"))); totEl.textContent = fmt(parseFloat(totEl.getAttribute('data-subtotal'))); return; }
                feeEl.textContent = fmt(fee); totEl.textContent = fmt(parseFloat(totEl.getAttribute('data-subtotal')) + fee);
            }
            gov.addEventListener('change', updateFee); updateFee();
            var sending = false;
            form.addEventListener('submit', function (e) {
                if (sending) { e.preventDefault(); return; }
                if (!form.checkValidity()) return;      // let the browser show the validation messages
                e.preventDefault();
                sending = true;
                btn.classList.add('is-done');             // show the tick, then send the order
                setTimeout(function () { form.submit(); }, 900);
            });
        })();
    </script>
}
