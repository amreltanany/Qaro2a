@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    ViewData["Title"] = L("Podcast", "بودكاست");
    ViewData["SeoTitle"] = L(
        "Qaro2a Podcast — Arabic Book Discussions & Reviews",
        "بودكاست قروءه — حلقات كتب ومراجعات أدبية");
    ViewData["MetaDescription"] = L(
        "Watch and listen to Qaro2a podcast episodes about Arabic books, stories, and literature. Book summaries, reviews, and deep discussions.",
        "شاهد واستمع إلى حلقات بودكاست قروءه عن الكتب العربية والقصص والأدب. ملخصات ومراجعات ومناقشات تفصيلية للكتب.");
    ViewData["MetaKeywords"] = L(
        "Qaro2a podcast, Arabic book podcast, book reviews, literature",
        "بودكاست قروءه, بودكاست كتب, مراجعات كتب, أدب, قراءة");
}
@section Head {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "PodcastSeries",
      "name": "@(isArabic ? "بودكاست قروءه" : "Qaro2a Podcast")",
      "alternateName": ["Qaro2a", "قروءه", "قروءة"],
      "description": "@(isArabic ? "بودكاست عربي عن الكتب والقراءة والأدب." : "An Arabic podcast about books, reading, and literature.")",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/Home/Podcast?culture={currentCulture}")",
      "inLanguage": "ar",
      "webFeed": "https://www.youtube.com/@@Qaro2a/"
    }
    </script>
}

<section class="podcast-page py-4 py-md-5" style="background: #0b1220; min-height: 100vh;">
    <div class="container px-3 px-md-4">
        <div class="text-center text-white mb-4 mb-md-5 px-2">
            <h1 class="mb-2">@L("Podcast", "بودكاست")</h1>
            <p class="mb-0">@L("Watch the latest videos from Qaro2a.", "شاهد أحدث فيديوهات قروءه.")</p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-4">
                <div class="ratio ratio-16x9 rounded overflow-hidden shadow">
                    <iframe src="https://www.youtube-nocookie.com/embed/p-fTWfd85cU?rel=0"
                            title="Qaro2a Video 1" loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div>
            </div>
