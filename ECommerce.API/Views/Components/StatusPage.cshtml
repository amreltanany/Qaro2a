@{
    var isArabic = string.Equals(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    var code = ViewData["Code"] is int c ? c : 404;
    var is404 = code == 404;
    var title = code switch
    {
        403 => L("You don't have access to this page", "مش مسموح لك بدخول الصفحة دي"),
        404 => L("We couldn't find this page", "الصفحة دي مش موجودة"),
        _ => L("Something went wrong", "حصلت مشكلة")
    };
    var text = code switch
    {
        403 => L("Please log in with an account that has access.", "سجّل الدخول بحساب له صلاحية الدخول."),
        404 => L("The page you are looking for is missing, but here’s a cookie for you.", "الصفحة اللي بتدور عليها مش موجودة، بس معانا كوكي ليك."),
        _ => L("We could not complete your request right now. Please try again in a moment.", "ماقدرناش نكمّل طلبك دلوقتي. حاول تاني بعد شوية.")
    };
    ViewData["Title"] = title;
    var arrow = isArabic ? "←" : "→";
}

<section class="status-page">
    <div class="status-card">
        @if (is404)
        {
            <div class="status-404" role="img" aria-label="404">
                <span class="status-404__digit" aria-hidden="true">4</span>
                <img class="status-404__cookie" src="~/images/404-cookie.webp" alt="" width="235" height="236" decoding="async" />
                <span class="status-404__digit" aria-hidden="true">4</span>
            </div>
        }
        else
        {
            <div class="status-page__code" aria-hidden="true">@code</div>
        }
        <h1 class="@(is404 ? "visually-hidden" : "status-page__title")">@(is404 ? L("Page not found", "الصفحة مش موجودة") : title)</h1>
        <p class="status-page__text">@text</p>
        <a asp-controller="Home" asp-action="@(is404 ? "Index" : "Shop")" class="status-page__go">@(is404 ? L("Take It and Go Back", "خدها وارجع") : L("Browse the shop", "تصفّح المتجر")) <span aria-hidden="true">@arrow</span></a>
        @if (!is404)
        {
            <a asp-controller="Home" asp-action="Index" class="status-page__home">@L("Back to home", "الرئيسية")</a>
        }
    </div>
</section>

<style>
    .status-page { padding: 7.5rem 1rem 4rem; background: #f7f3eb; min-height: 70vh; display: flex; align-items: center; justify-content: center; }
    .status-card { width: min(100%, 940px); padding: clamp(2rem, 6vw, 4.5rem) 1.5rem clamp(2rem, 5vw, 3.5rem); border-radius: 26px; background: #fff; text-align: center; box-shadow: 0 30px 60px -30px rgba(0, 52, 110, .35), 0 8px 24px -12px rgba(0, 52, 110, .18); animation: status-in .6s cubic-bezier(.22, 1, .36, 1) both; }
    .status-404 { display: flex; align-items: flex-end; justify-content: center; gap: 0; direction: ltr; margin-bottom: 1.4rem; }
    .status-404__digit { font-family: var(--font-heading); font-weight: 700; font-size: clamp(5.5rem, 15vw, 9.5rem); line-height: .8; color: #00346e; letter-spacing: -.02em; }
    .status-404__cookie { width: clamp(9.5rem, 27vw, 16.5rem); height: auto; margin-bottom: -.8rem; animation: cookie-float 5s ease-in-out infinite; filter: drop-shadow(0 14px 14px rgba(60, 35, 20, .18)); }
    .status-page__code { font-family: var(--font-heading); font-size: clamp(5rem, 16vw, 9rem); font-weight: 700; line-height: 1; letter-spacing: -.03em; color: #00346e; }
    .status-page__title { margin: 1.4rem 0 .5rem; font-size: clamp(1.2rem, 2.6vw, 1.7rem); font-weight: 600; color: #00346e; }
    .status-page__text { max-width: 30rem; margin: 0 auto 1.6rem; color: #5a6b82; line-height: 1.9; }
    .status-page__go { display: inline-flex; align-items: center; gap: .5rem; padding: .8rem 1.7rem; border-radius: 999px; background: #0270b8; color: #fff; font-weight: 600; text-decoration: none; box-shadow: 0 12px 22px -10px rgba(2, 112, 184, .7); transition: background .2s ease, transform .2s ease; }
    .status-page__go:hover { background: #00346e; color: #fff; transform: translateY(-2px); }
    .status-page__home { display: block; margin-top: 1rem; color: #5a6b82; font-size: .9rem; text-decoration: none; }
    .status-page__home:hover { color: #0270b8; }
    @@keyframes status-in { from { opacity: 0; transform: translateY(18px) scale(.985); } to { opacity: 1; transform: none; } }
    @@keyframes cookie-float { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-7px) rotate(1.5deg); } }
</style>
