@model IList<ECommerce.Application.DTOs.Product.ProductResponseDto>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    ViewData["Title"] = L("Home", "الرئيسية");
    ViewData["SeoTitle"] = L(
        "Qaro2a — Arabic Books Podcast, Bookstore & Publishing",
        "قروءه — بودكاست كتب، متجر كتب ونشر أدبي");
    ViewData["MetaDescription"] = L(
        "Qaro2a is a literary hub for Arabic books, podcast episodes, book reviews, and publishing. Shop curated titles and join our reading community.",
        "قروءه منصة أدبية للبودكاست ومراجعات الكتب والنشر. تسوق كتباً مختارة بالعربية واستمع إلى حلقات بودكاست قروءه عن الكتب والقراءة.");
    ViewData["MetaKeywords"] = L(
        "Qaro2a, Arabic books, book podcast, bookstore, publishing, literature",
        "قروءه, قروءة, بودكاست كتب, كتب عربية, متجر كتب, نشر, مراجعات كتب, بودكاست");
    string Q(string virtualPath, int width, string format, int quality = 82)
        => $"{Url.Content(virtualPath)}?width={width}&format={format}&quality={quality}";

    // Hero layers (scroll-3d). Drop hero-bg-ar.webp next to hero-bg.webp to serve an Arabic background.
    var heroBgPath = "~/images/hero/hero-bg.webp";
    if (isArabic && System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "images", "hero", "hero-bg-ar.webp")))
        heroBgPath = "~/images/hero/hero-bg-ar.webp";
    var heroBg = Url.Content(heroBgPath);
    var heroProduct = Url.Content("~/images/hero/hero-product.webp");
    var publishBannerUrl = Q("~/logo/test24.jpg", 1920, "jpeg", 82);
    var aboutBackgroundUrl = Q("~/logo/aboutUsBackgrpound.png", 1600, "jpeg", 78);
}

@section Head {
    <link rel="preload" as="image" href="@heroBg" type="image/webp" fetchpriority="high" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/inter-ui@3.11.0/inter.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/button.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop-page.css" asp-append-version="true" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebPage",
      "name": "@(isArabic ? "قروءه — بودكاست وكتب ونشر أدبي" : "Qaro2a — Books, Podcast & Publishing")",
      "alternateName": ["Qaro2a", "قروءه", "قروءة"],
      "description": "@(isArabic ? "قروءه منصة عربية للبودكاست ومتجر الكتب والنشر الأدبي." : "Qaro2a is an Arabic literary platform for podcasts, books, and publishing.")",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/?culture={currentCulture}")",
      "inLanguage": "@currentCulture",
      "isPartOf": {
        "@@type": "WebSite",
        "name": "@(isArabic ? "قروءه" : "Qaro2a")",
        "url": "https://qaro2a.com"
      }
    }
    </script>
}

<!--Hero-->
<section class="overflow-hidden home-hero hero3d">
    <div class="hero3d__stage" id="hero3d">
        <img class="hero3d__bg" src="@heroBg" alt="@L("Qaro2a — books, podcast and publishing", "قروءه — بودكاست وكتب ونشر أدبي")"
            width="1538" height="806" decoding="async" fetchpriority="high">
        <div class="hero3d__product">
            <span class="hero3d__contact" aria-hidden="true"></span>
            <img class="hero3d__product-img" src="@heroProduct" alt="" aria-hidden="true"
                width="1193" height="739" decoding="async">
        </div>
    </div>
</section>
<!--Hero-->

<section class="home-brand-intro" dir="@(isArabic ? "rtl" : "ltr")" aria-label="@L("Qaro2a brand", "قروءه")">
    <div class="container site-container text-center py-4 py-md-5">
        <h1 class="home-brand-title mb-2" data-aos="fade-up">
            @L("Qaro2a — Books, Podcast & Publishing", "قروءه — بودكاست وكتب ونشر أدبي")
        </h1>
        <p class="home-brand-tagline mb-0" data-aos="fade-up" data-aos-delay="150">
            @L("Your literary hub for Arabic books, podcast episodes, and publishing.", "منصتك الأدبية للكتب العربية وحلقات البودكاست والنشر — قروءه وقروءة في مكان واحد.")
        </p>
    </div>
</section>

<!--New Arrivals-->
<section id="billboard" class="overflow-hidden">
    <div class="container site-container">
        <div class="row justify-content-center">
            <h2 class="section-title text-center mt-2" data-aos="fade-up">@L("Top Rated Books", "كتب الأعلى تقييماً")</h2>
            <div class="col-md-6 text-center" data-aos="fade-up" data-aos-delay="300">
                <p>
                    @L("Every book in our collection is more than just pages-it is a perspective. At Qaro2a, we believe storytelling is the heartbeat of humanity. From curated bestsellers to hidden gems by independent voices, we provide a platform where every narrative finds its home and every reader finds their next adventure.", "كل كتاب في مجموعتنا ليس مجرد صفحات، بل منظور مختلف. في قروءه نؤمن أن السرد هو نبض الإنسانية. من الكتب الأكثر مبيعًا إلى الكنوز المخفية لأصوات مستقلة، نوفر منصة يجد فيها كل سرد موطنه ويجد فيها كل قارئ مغامرته القادمة.")
                </p>
            </div>
        </div>
        <div class="row g-0">
            <div class="shop-products-row top-rated-slider py-2 py-md-3" data-aos="fade-up" data-aos-delay="600">
                <div class="top-rated-track">
                    @foreach (var product in Model)
                    {
                        var cardImg = Url.Content(product.ImageUrl ?? "~/logo/429827302_747764070661978_6323408778619379006_n-removebg-preview.png");
                        var productPath = ECommerce.API.Helpers.SlugHelper.ProductPath(product.Id, product.Name);
                        <div class="top-rated-item">
                            <div class="banner-item image-zoom-effect product-card h-100">
                                <div class="image-holder shop-card-media">
                                    @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                                    {
                                        <span class="shop-card-badge">@ECommerce.API.Helpers.CategoryLabels.Localize(product.CategoryName, isArabic)</span>
                                    }
                                    <button type="button" class="shop-wishlist-btn btn-add-wishlist" title="@L("Add to wishlist", "إضافة للمفضلة")" aria-label="@L("Add to wishlist", "إضافة للمفضلة")"
                                            data-product-id="@product.Id" data-product-name="@product.Name">
                                        <i class="bi bi-heart"></i>
                                    </button>
                                    <a href="@productPath" class="shop-card-cover-link" aria-label="@product.Name">
                                        <img src="@cardImg" alt="@product.Name" class="img-fluid" loading="lazy" decoding="async" />
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(product.Description))
                                    {
                                        <div class="shop-card-peek" dir="rtl" aria-hidden="true">
                                            <p>@product.Description</p>
                                        </div>
                                    }
                                </div>
                                <div class="banner-content shop-card-body">
                                    <div class="shop-card-text" dir="rtl">
                                        <h5 class="element-title">
                                            <a class="item-anchor shop-card-title-link" href="@productPath">@product.Name</a>
                                        </h5>
                                        <p class="shop-card-description">@product.Description</p>
                                        <div class="shop-card-meta">
                                            <a href="/Home/Author/@Uri.EscapeDataString(product.Author.Trim().Replace(" ", "-"))" class="shop-card-author-chip">@product.Author</a>
                                        </div>
                                    </div>
                                    @{ var buyable = product.Stock > 0 || ((ViewBag.MyCartProducts as HashSet<int>)?.Contains(product.Id) ?? false); }
<div class="shop-card-actions @(buyable ? null : "shop-card-actions--out-of-stock")" data-out-label="@L("Out of stock", "غير متوفر")">
                                        <p class="shop-card-price mb-0" dir="ltr">@product.Price.ToString("N0") <span class="shop-card-currency">EGP</span></p>
                                        @if (buyable)
                                        {
                                            <div class="shop-qty" data-remove-label="@L("Remove from cart", "إزالة من السلة")" data-max="@product.Stock" role="group" aria-label="@L("Quantity", "الكمية")">
                                                <button type="button" class="shop-qty__btn" data-qty-step="-1" aria-label="@L("Decrease quantity", "تقليل الكمية")" disabled>&minus;</button>
                                                <output class="shop-qty__val" aria-live="polite">1</output>
                                                <button type="button" class="shop-qty__btn" data-qty-step="1" aria-label="@L("Increase quantity", "زيادة الكمية")"@(product.Stock > 1 ? "" : " disabled")>+</button>
                                            </div>
                                            <button type="button" class="button btn-add-cart shop-cart-animate" data-product-id="@product.Id" data-product-name="@product.Name" aria-label="@L("Add to cart", "أضف إلى السلة")">
                                                <i class="bi bi-cart3 shop-cart-idle" aria-hidden="true"></i>
                                                <span class="shop-cart-label">
                                                    <i class="bi bi-plus-lg shop-cart-plus-icon" aria-hidden="true"></i>
                                                    @L("Add to cart", "أضف إلى السلة")
                                                </span>
                                                <div class="cart">
                                                    <svg viewBox="0 0 36 26">
                                                        <polyline points="1 2.5 6 2.5 10 18.5 25.5 18.5 28.5 7.5 7.5 7.5"></polyline>
                                                        <polyline points="15 13.5 17 15.5 22 10.5"></polyline>
                                                    </svg>
                                                </div>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="shop-oos-truck-wrap" title="@L("Out of stock", "غير متوفر")"><svg class="shop-oos-truck" viewBox="0 0 120 70" aria-hidden="true" focusable="false"><g fill="currentColor"><rect x="2" y="22" width="34" height="5" rx="2.5"/><rect x="9" y="33" width="30" height="5" rx="2.5"/><rect x="14" y="44" width="26" height="5" rx="2.5"/><path d="M30 10h52l-2 40H26z"/><path d="M86 22h16l10 14v16h-26z"/><rect x="20" y="52" width="96" height="8" rx="2"/></g><path d="M92 27h8l6 8H92z" fill="#fff"/><g fill="currentColor" stroke="#fff" stroke-width="3"><circle cx="42" cy="58" r="9"/><circle cx="96" cy="58" r="9"/></g><g fill="#fff"><circle cx="42" cy="58" r="3.4"/><circle cx="96" cy="58" r="3.4"/></g></svg></span>
                                            <button type="button" class="shop-out-of-stock-btn" disabled>
                                                <span>@L("Out of stock", "غير متوفر")</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!--New Arrivals-->

