<!--broadcast-aboutUs-->
<section class="home-about-section home-page-end" style="--about-bg: url('@aboutBackgroundUrl');">
    <div class="container site-container">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-6 order-2 order-lg-1 home-about-text">
                <h2 class="home-about-title">@L("About Us", "من نحن")</h2>
                <p class="home-about-copy">@L("Qaro2a is a platform for book lovers to discover and share their favorite books. We are a team of book lovers who are passionate about books and we believe that books are the best way to learn and grow.", "قروءه منصة لعشاق الكتب لاكتشاف كتبهم المفضلة ومشاركتها. نحن فريق شغوف بالقراءة ونؤمن أن الكتب هي أفضل طريق للتعلم والنمو.")</p>
                <a asp-controller="Home" asp-action="About" class="home-about-link">@L("Read more", "اقرأ المزيد")</a>
            </div>
            <div class="col-12 col-lg-6 order-1 order-lg-2 home-about-media">
                <div class="ratio ratio-16x9 home-about-video shadow-sm">
                    <iframe src="https://www.youtube-nocookie.com/embed/RHT52TyjWWI?rel=0&amp;controls=0"
                        title="YouTube video player" loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div>
                <p class="home-about-view-more mb-0">
                    <a href="https://www.youtube.com/@@Qaro2a/" target="_blank" rel="noopener noreferrer">@L("View more", "شاهد المزيد")</a>
                </p>
            </div>
        </div>
    </div>
    <div class="home-footer-bridge" aria-hidden="true"></div>
</section>
