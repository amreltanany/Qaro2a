@model IList<ECommerce.Application.DTOs.Product.ProductResponseDto>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isArabic ? ar : en;
    ViewData["Title"] = L("Home", "الرئيسية");
    ViewData["SeoTitle"] = L(
        "Qaro2a — Arabic Books Podcast, Bookstore & Publishing",
        "قروءه — بودكاست كتب، متجر كتب ونشر أدبي");
    ViewData["MetaDescription"] = L(
        "Qaro2a is a literary hub for Arabic books, podcast episodes, book reviews, and publishing. Shop curated titles and join our reading community.",
        "قروءه منصة أدبية للبودكاست ومراجعات الكتب والنشر. تسوق كتباً مختارة بالعربية واستمع إلى حلقات بودكاست قروءه عن الكتب والقراءة.");
    ViewData["MetaKeywords"] = L(
        "Qaro2a, Arabic books, book podcast, bookstore, publishing, literature",
        "قروءه, قروءة, بودكاست كتب, كتب عربية, متجر كتب, نشر, مراجعات كتب, بودكاست");
    string Q(string virtualPath, int width, string format, int quality = 82)
        => $"{Url.Content(virtualPath)}?width={width}&format={format}&quality={quality}";

    // Hero layers (scroll-3d). Drop hero-bg-ar.webp next to hero-bg.webp to serve an Arabic background.
    var heroBgPath = "~/images/hero/hero-bg.webp";
    if (isArabic && System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "images", "hero", "hero-bg-ar.webp")))
        heroBgPath = "~/images/hero/hero-bg-ar.webp";
    var heroBg = Url.Content(heroBgPath);
    var heroProduct = Url.Content("~/images/hero/hero-product.webp");
    var publishBannerUrl = Q("~/logo/test24.jpg", 1920, "jpeg", 82);
    var aboutBackgroundUrl = Q("~/logo/aboutUsBackgrpound.png", 1600, "jpeg", 78);
}

@section Head {
    <link rel="preload" as="image" href="@heroBg" type="image/webp" fetchpriority="high" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebPage",
      "name": "@(isArabic ? "قروءه — بودكاست وكتب ونشر أدبي" : "Qaro2a — Books, Podcast & Publishing")",
      "alternateName": ["Qaro2a", "قروءه", "قروءة"],
      "description": "@(isArabic ? "قروءه منصة عربية للبودكاست ومتجر الكتب والنشر الأدبي." : "Qaro2a is an Arabic literary platform for podcasts, books, and publishing.")",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/?culture={currentCulture}")",
      "inLanguage": "@currentCulture",
      "isPartOf": {
        "@@type": "WebSite",
        "name": "@(isArabic ? "قروءه" : "Qaro2a")",
        "url": "https://qaro2a.com"
      }
    }
    </script>
}

<!--Hero-->
<section class="overflow-hidden home-hero hero3d">
    <div class="hero3d__stage" id="hero3d">
        <img class="hero3d__bg" src="@heroBg" alt="@L("Qaro2a — books, podcast and publishing", "قروءه — بودكاست وكتب ونشر أدبي")"
            width="1538" height="806" decoding="async" fetchpriority="high">
        <div class="hero3d__product">
            <span class="hero3d__contact" aria-hidden="true"></span>
            <img class="hero3d__product-img" src="@heroProduct" alt="" aria-hidden="true"
                width="1193" height="739" decoding="async">
        </div>
    </div>
</section>
<!--Hero-->

<section class="home-brand-intro" dir="@(isArabic ? "rtl" : "ltr")" aria-label="@L("Qaro2a brand", "قروءه")">
    <div class="container site-container text-center py-4 py-md-5">
        <h1 class="home-brand-title mb-2" data-aos="fade-up">
            @L("Qaro2a — Books, Podcast & Publishing", "قروءه — بودكاست وكتب ونشر أدبي")
        </h1>
        <p class="home-brand-tagline mb-0" data-aos="fade-up" data-aos-delay="150">
            @L("Your literary hub for Arabic books, podcast episodes, and publishing.", "منصتك الأدبية للكتب العربية وحلقات البودكاست والنشر — قروءه وقروءة في مكان واحد.")
        </p>
    </div>
</section>

<!--New Arrivals-->
<section id="billboard" class="overflow-hidden">
    <div class="container site-container">
        <div class="row justify-content-center">
            <h2 class="section-title text-center mt-2" data-aos="fade-up">@L("Top Rated Books", "كتب الأعلى تقييماً")</h2>
            <div class="col-md-6 text-center" data-aos="fade-up" data-aos-delay="300">
                <p>
                    @L("Every book in our collection is more than just pages-it is a perspective. At Qaro2a, we believe storytelling is the heartbeat of humanity. From curated bestsellers to hidden gems by independent voices, we provide a platform where every narrative finds its home and every reader finds their next adventure.", "كل كتاب في مجموعتنا ليس مجرد صفحات، بل منظور مختلف. في قروءه نؤمن أن السرد هو نبض الإنسانية. من الكتب الأكثر مبيعًا إلى الكنوز المخفية لأصوات مستقلة، نوفر منصة يجد فيها كل سرد موطنه ويجد فيها كل قارئ مغامرته القادمة.")
                </p>
            </div>
        </div>
        <div class="row g-0">
            <div class="swiper main-swiper py-2 py-md-3" data-aos="fade-up" data-aos-delay="600">
                <div class="swiper-wrapper border-animation-left">
                    @foreach (var product in Model)
                    {
                        var rawImg = product.ImageUrl ?? "~/logo/429827302_747764070661978_6323408778619379006_n-removebg-preview.png";
                        var productSrc = Url.Content(rawImg);
                        if (!productSrc.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                        {
                            var q = productSrc.Contains('?', StringComparison.Ordinal) ? '&' : '?';
                            productSrc = $"{productSrc}{q}width=720&format=webp&quality=80";
                        }

                        <div class="swiper-slide">
                            <div class="banner-item image-zoom-effect">
                                <div class="image-holder">
                                    <a href="@ECommerce.API.Helpers.SlugHelper.ProductPath(product.Id, product.Name)">
                                        <img src="@productSrc"
                                            alt="@product.Name" class="img-fluid" loading="lazy" decoding="async"
                                            width="400" height="300"
                                            style="width: 100%; height: 420px; object-fit: contain; background: #f4f3f0;">
                                    </a>
                                </div>
                                <div class="banner-content home-book-caption py-4 px-2 px-md-3" dir="rtl">
                                    <h5 class="element-title">
                                        <a href="@ECommerce.API.Helpers.SlugHelper.ProductPath(product.Id, product.Name)" class="item-anchor">@product.Name</a>
                                    </h5>
                                    <p class="home-book-description mb-0">@product.Description</p>
                                    <div class="btn-left">
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!--New Arrivals-->

<!--publish-->
<section class="home-publish-banner overflow-hidden">
    <a asp-controller="Home" asp-action="Publish" class="d-block">
        <img src="@publishBannerUrl" alt="@L("Publish with Qaro2a", "انشر مع قروءه")" class="img-fluid w-100" data-aos="fade-up"
            width="1920" height="600" loading="lazy" decoding="async">
    </a>
</section>
